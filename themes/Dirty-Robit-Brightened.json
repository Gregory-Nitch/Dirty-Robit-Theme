	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#91A085"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.control.flow",
				"keyword.operator.cast.const_cast.cpp",
				"keyword.operator.cast.dynamic_cast.cpp",
				"keyword.operator.cast.reinterpret_cast.cpp",
				"keyword.operator.cast.static_cast.cpp",
				"keyword.other.namespace.definition.cpp",
				"keyword.operator.word",
				"storage",
				"storage.type",
				"storage.type.class.cpp",
				"storage.type.enum.enum-key.class.cpp",
				"storage.type.enum.cpp",
				"storage.type.namespace.definition.cpp",
				"storage.type.struct.cpp",
				"storage.modifier",
				"storage.modifier.specifier",
				"storage.type.primitive",
				"keyword.other.template"
			],
			"settings": {
				"foreground": "#D17A62"
			}
		},
		{
			"name": "Markdown Headings",
			"scope": [
				"markup.heading",
				"markup.heading.markdown",
				"entity.name.section.markdown",
				"markup.heading.markdown punctuation.definition.heading.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#D17A62",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Inline Code",
			"scope": [
				"markup.inline.raw.markdown",
				"markup.inline.raw.string.markdown",
				"punctuation.definition.raw.markdown"
			],
			"settings": {
				"foreground": "#D4BC6A"
			}
		},
		{
			"name": "Variables and plain identifiers",
			"scope": [
				"variable",
				"identifier"
			],
			"settings": {
				"foreground": "#DDD6CC"
			}
		},
		{
			"name": "Parameters and member variables",
			"scope": [
				"variable.parameter",
				"variable.other.property",
				"variable.other.member",
				"variable.object.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#D2B690"
			}
		},
		{
			"name": "Functions and methods",
			"scope": [
				"entity.name.function",
				"entity.name.function.member",
				"keyword.other.operator.overload.cpp",
				"markup.bold.markdown",
				"markup.bold.markdown punctuation.definition.bold",
				"markup.list punctuation.definition.list.begin.markdown",
				"punctuation.definition.list.begin.markdown",
				"meta.function.definition entity.name.function",
				"meta.function-call",
				"meta.function-call entity.name.function",
				"variable.function",
				"support.function"
			],
			"settings": {
				"foreground": "#E09B5B"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.union",
				"entity.name.scope-resolution.function.call.cpp",
				"support.type.primitive",
				"support.type",
				"support.class",
				"storage.type",
				"storage.type.template",
				"meta.generic",
				"entity.name.type.template"
			],
			"settings": {
				"foreground": "#ADB7C1"
			}
		},
		{
			"name": "Namespaces",
			"scope": [
				"entity.name.namespace",
				"entity.name.namespace.cpp",
				"entity.name.scope-resolution.cpp",
				"support.other.namespace",
				"meta.namespace"
			],
			"settings": {
				"foreground": "#9E8686"
			}
		},
		{
			"name": "Numbers and constants",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.language.boolean",
				"constant.language.nullptr",
				"constant.character",
				"constant.other",
				"support.constant"
			],
			"settings": {
				"foreground": "#89B2D0"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#D4BC6A"
			}
		},
		{
			"name": "Operators and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"delimiter",
				"punctuation.separator.namespace.access"
			],
			"settings": {
				"foreground": "#DDD6CC"
			}
		},
		{
			"name": "Preprocessor, macros, attributes",
			"scope": [
				"entity.name.function.preprocessor",
				"meta.preprocessor",
				"markup.italic.markdown",
				"markup.italic.markdown punctuation.definition.italic",
				"keyword.control.directive",
				"keyword.control.directive.defined",
				"punctuation.definition.directive",
				"entity.other.attribute-name",
				"storage.modifier.attribute",
				"meta.attribute",
				"support.annotation"
			],
			"settings": {
				"foreground": "#A68EB8"
			}
		},
		{
			"name": "Python function definition",
			"scope": [
				"storage.type.function.python"
			],
			"settings": {
				"foreground": "#D17A62"
			}
		},
		{
			"name": "HTML tags",
			"scope": [
				"entity.name.tag",
				"meta.tag",
				"punctuation.definition.tag",
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag.end"
			],
			"settings": {
				"foreground": "#D17A62"
			}
		},
		{
			"name": "HTML and CSS attributes",
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"meta.attribute-with-value.attribute-name"
			],
			"settings": {
				"foreground": "#D2B690"
			}
		}
	],
	"semanticTokenColors": {
		"comment": "#91A085",
		"keyword": "#D17A62",
		"operator": "#DDD6CC",
		"variable": "#DDD6CC",
		"variable.global": "#D2B690",
		"variable.defaultLibrary": "#DDD6CC",
		"variable.readonly": "#89B2D0",
		"parameter": "#D2B690",
		"property": "#D2B690",
		"property.readonly": "#89B2D0",
		"function": "#E09B5B",
		"method": "#E09B5B",
		"memberOperatorOverload": "#E09B5B",
		"macro": "#A68EB8",
		"number": "#89B2D0",
		"enumMember": "#89B2D0",
		"string": "#D4BC6A",
		"type": "#ADB7C1",
		"type.defaultLibrary": "#ADB7C1",
		"class": "#ADB7C1",
		"struct": "#ADB7C1",
		"enum": "#ADB7C1",
		"typeParameter": "#ADB7C1",
		"namespace": "#9E8686",
		"decorator": "#A68EB8"
	}
